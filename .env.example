# Скопируй в .env и замени значения. Файл .env в git не попадает.
# Сгенерировать ключ: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-string-of-at-least-32-chars
DATABASE_URL=postgresql://sirius:sirius@localhost:5432/sirius_food
REDIS_URL=redis://localhost:6379/0
DEBUG=false
ALLOWED_ORIGINS=["http://localhost:5173"]
REPOSITORY_BACKEND=postgres

# Вход через Google: https://console.cloud.google.com/apis/credentials
# Тип клиента Web application, Authorized redirect URI совпадает с GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
