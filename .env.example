# Скопируй в .env и замени значения. Файл .env в git не попадает.
# Сгенерировать ключ: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-string-of-at-least-32-chars
DATABASE_URL=postgresql://sirius:sirius@localhost:5432/sirius_food
REDIS_URL=redis://localhost:6379/0
DEBUG=false
ALLOWED_ORIGINS=["http://localhost:5173"]
REPOSITORY_BACKEND=postgres
# false выключает кеш меню, нужно для замера «до».
MENU_CACHE_ENABLED=true
# celery ставит PDF, email и SMS в очередь, sync выполняет их в запросе. sync нужен для замера «до».
ORDER_TASKS_MODE=celery
# Сбои заглушек: почта лежит для каждого 5-го заказа, SMS не проходит с первой попытки для каждого 3-го.
FAKE_EMAIL_FAIL_EVERY=5
FAKE_SMS_FLAKY_EVERY=3

# Вход через Google: https://console.cloud.google.com/apis/credentials
# Тип клиента Web application, Authorized redirect URI совпадает с GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Доставка: grpc вызывает микросервис (python -m delivery_service), local выполняет код в монолите.
DELIVERY_BACKEND=grpc
DELIVERY_GRPC_TARGET=localhost:50051
DELIVERY_GRPC_BIND=127.0.0.1:50051

# Брокер событий: docker compose up -d rabbitmq, веб-интерфейс http://localhost:15672
RABBITMQ_URL=amqp://sirius:sirius@localhost:5672/

# Учебная практика: сайт, оплата и локальный AI.
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080
# demo не списывает деньги; yookassa требует ключей тестового магазина.
PAYMENT_PROVIDER=demo
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# В Compose Ollama на компьютере доступна по host.docker.internal.
# При использовании профиля ai замените на http://ollama:11434.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b-instruct-q5_K_M
OLLAMA_EMBED_MODEL=bge-m3:latest
# For the monitoring profile set OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317.
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
AI_TIMEOUT=180
# Необязательно: создать тестовые аккаунты четырёх ролей. Задайте свой пароль >= 8 символов.
DEMO_PASSWORD=
# Локальный вход только для платёжного webhook; используется профилем webhooks.
WEBHOOK_PORT=8082
# Желаемое уникальное имя Localtunnel (бесплатный сервис без гарантии доступности).
WEBHOOK_SUBDOMAIN=sirius-eda-practice

# Grafana: профиль monitoring, доступ только с localhost.
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=sirius-local-admin
PROMETHEUS_PORT=9090
JAEGER_UI_PORT=16686
# При нехватке места в Docker можно использовать заранее созданные локальные каталоги.
# LOKI_STORAGE=./.local/monitoring/loki
# GRAFANA_STORAGE=./.local/monitoring/grafana
# ALLOY_STORAGE=./.local/monitoring/alloy
# PROMETHEUS_STORAGE=./.local/monitoring/prometheus

# Existing Ollama in Hoshi's WSL via the optional remote-ai profile:
# OLLAMA_URL=http://ollama-remote:11434
# OLLAMA_HOST_HEADER=localhost:11434
# OLLAMA_SSH_AGENT=/absolute/path/to/unlocked/ssh-agent.sock
OLLAMA_SSH_HOST=100.84.145.91
OLLAMA_SSH_USER=tolex
