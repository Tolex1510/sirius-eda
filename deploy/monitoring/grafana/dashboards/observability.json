{
  "uid": "sirius-observability",
  "title": "Сириус.Еда — Observability",
  "tags": ["sirius", "observability", "lab-9"],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP requests / s",
      "datasource": { "type": "prometheus", "uid": "sirius-prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum by (handler, method) (rate(http_requests_total{job=\"sirius-api\"}[5m]))", "legendFormat": "{{method}} {{handler}}", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP latency p95",
      "datasource": { "type": "prometheus", "uid": "sirius-prometheus" },
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"sirius-api\"}[5m])))", "legendFormat": "p95", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP 5xx / s",
      "datasource": { "type": "prometheus", "uid": "sirius-prometheus" },
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 8 },
      "targets": [{ "expr": "sum(rate(http_requests_total{job=\"sirius-api\",status=~\"5..\"}[5m]))", "legendFormat": "5xx", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Заказы / s",
      "datasource": { "type": "prometheus", "uid": "sirius-prometheus" },
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 8 },
      "targets": [{ "expr": "rate(sirius_orders_created_total[5m])", "legendFormat": "заказы", "refId": "A" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Сообщения, ожидающие кухни",
      "datasource": { "type": "prometheus", "uid": "sirius-prometheus" },
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 8 },
      "targets": [{ "expr": "rabbitmq_queue_messages_ready{queue=\"kitchen_queue\"}", "legendFormat": "kitchen_queue", "refId": "A" }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Cache hit rate",
      "datasource": { "type": "prometheus", "uid": "sirius-prometheus" },
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [{ "expr": "sum(rate(sirius_cache_operations_total{result=\"hit\"}[5m])) / clamp_min(sum(rate(sirius_cache_operations_total{result=~\"hit|miss\"}[5m])), 0.000001)", "legendFormat": "hit rate", "refId": "A" }]
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Логи API и consumer'ов (Loki)",
      "datasource": { "type": "loki", "uid": "sirius-loki" },
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 10 },
      "targets": [{ "expr": "{app=\"sirius-eda\", service=~\"api|kitchen|delivery|orders|payments|outbox\"} |= \"correlation_id\"", "refId": "A" }]
    }
  ],
  "annotations": { "list": [] },
  "templating": { "list": [] }
}
